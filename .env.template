# LLM provider
MONTFERRAND_PROVIDER=openrouter
MONTFERRAND_MODEL=google/gemini-2.5-flash-lite

# OpenRouter (recommended for Claude and most third-party models)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Inception (recommended for Mercury direct)
INCEPTION_API_KEY=sk-inception-...
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1

# Optional separate judge backend/model for evals
MONTFERRAND_JUDGE_PROVIDER=openrouter
MONTFERRAND_JUDGE_MODEL=google/gemini-2.5-flash-lite

# Twilio
# Required for server startup and webhook signature verification.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# MONTFERRAND_TWILIO_STATUS_CALLBACK_URL=https://your-app.example.com/twilio/status

# Multi-tenant
MONTFERRAND_ADMIN_TOKEN=a-strong-random-secret
MONTFERRAND_DEMO_TENANT=+15551234567
MONTFERRAND_BASE_URL=https://your-app.example.com
# MONTFERRAND_HOST=my-app.fly.dev
MONTFERRAND_DATA_DIR=/opt/montferrand
MONTFERRAND_TIMEZONE=America/Montreal
MONTFERRAND_JOB_CARD_TOKEN_TTL_HOURS=72
# MONTFERRAND_DBMATE_BIN=dbmate
